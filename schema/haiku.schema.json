{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haikutravels.xyz/schema/haiku.schema.json",
  "title": "Haiku front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "date", "type", "author", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ht-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Immutable identifier, ht-YYYYMMDD-slug."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "date": { "type": "string", "format": "date", "description": "Day of the experience." },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "type": { "type": "string", "enum": ["travel", "food", "people", "nature", "everyday"] },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "const": "CC-BY-NC-ND-4.0" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "default": "en" },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "media": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string", "pattern": "^media/[0-9]{4}/[A-Za-z0-9._-]+\\.(jpe?g|png|webp)$" },
              "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
              "caption": { "type": ["string", "null"], "maxLength": 300 },
              "credit": { "type": ["string", "null"], "maxLength": 200 }
            }
          }
        }
      }
    },
    "notes": { "type": ["string", "null"], "description": "Private. Never published." },
    "collections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
